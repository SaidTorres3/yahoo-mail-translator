{
  "manifest_version": 3,
  "name": "Yahoo Mail en Español",
  "version": "4.0",
  "description": "Traduce la interfaz de Yahoo Mail al Español y permite configurar el refresco automático de la bandeja de entrada",
  "icons": {
    "128": "icon_128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yahoo-mail-translator@saidtorres.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Yahoo Mail en Español",
    "default_popup": "options.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["translations.json"],
      "matches": ["https://*.mail.yahoo.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.mail.yahoo.com/*"],
      "js": ["translate.js", "updateInbox.js"],
      "run_at": "document_end"
    }
  ]
}
